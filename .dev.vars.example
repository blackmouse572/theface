# Worker secrets. Loaded by wrangler in local dev; set with `wrangler secret put`
# in production. NEVER reaches the browser - put client-visible values in .env.

TYPESAFE_API_KEY=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Turnstile server half. Cloudflare's always-passes test secret is the default,
# so the flow works before you create a real widget. Replace before deploying.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

RATE_LIMIT_SALT=

# Local testing only. Forces the Audience of the celebrity Compliment, because `vite dev`
# sends no cf-ipcountry header. "vn" gives the Vietnamese pool and Vietnamese lines.
# Never set this in production.
AUDIENCE_OVERRIDE=
