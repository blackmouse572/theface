# Client-visible build values. The VITE_ prefix is what exposes a variable to
# the browser bundle, so NOTHING secret may go in this file.

# Turnstile public half. Safe to expose - it only identifies the widget.
# Cloudflare's test key always passes; swap it for your real site key.
#   1x00000000000000000000AA  always passes
#   2x00000000000000000000AB  always fails (use to test the rejection path)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Deployment origin. Canonical URLs, Open Graph URLs, JSON-LD and the sitemap all
# resolve against it. Wrong here means share cards and canonicals point elsewhere.
VITE_SITE_ORIGIN=http://localhost:3000
